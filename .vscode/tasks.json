{
  // Tasks do Bora — api/ (Laravel), queue (worker) e web/ (Next.js), em Docker.
  // "Run Build Task" executa "Bora: dev": sobe a stack e abre o navegador.
  //
  // Desde 2026-10-16 (ADR-0004) api, queue e web rodam em containers (compose.yaml,
  // na raiz) ligados ao MySQL e ao Redis compartilhados, que vivem em outra stack,
  // fora deste repositório: C:\docker\infra (containers infra-mysql e infra-redis,
  // com restart unless-stopped). Se "api: migrar banco" falhar por conexão recusada,
  // confira primeiro se a infra está no ar: `docker ps`.
  //
  // O IP da LAN e calculado na hora e passado como HOST_LAN_IPS, porque dentro do
  // container o Next so enxerga o IP do proprio container e recusaria o celular
  // (E-013). A validacao visual e feita no celular (Principio XI), por isso api e
  // web publicam 8000 e 3000 em todas as interfaces (E-011). Efeito colateral
  // aceito: em rede publica, a api de desenvolvimento fica visivel na LAN.
  //
  // `docker compose stop` para de verdade: acabou o servidor orfao que sobrevivia a
  // "parar a task" (E-010). Reiniciar o worker depois de renomear classe ou mexer
  // em service provider continua obrigatorio (E-018): task "queue: reiniciar".
  //
  // ATENCAO ao "npm.cmd" na task "web: build": e de proposito, nao troque por "npm".
  // Task do tipo "shell" no Windows roda em PowerShell, e a ExecutionPolicy desta
  // maquina e Restricted (LocalMachine), o que bloqueia o npm.ps1 com
  // UnauthorizedAccess. O npm.cmd e batch e nao passa pela ExecutionPolicy.
  // Ver E-006 no docs/logs/error-log.md. Essa task roda no host (Windows), nao no
  // container, para nao disputar o .next com o servidor de desenvolvimento.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stack: up",
      "detail": "Sobe api (8000), queue e web (3000) no Docker, com o IP da LAN",
      "type": "shell",
      "command": "$env:HOST_LAN_IPS = (Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq 'Up' } | Select-Object -First 1).IPv4Address.IPAddress; docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "abrir navegador",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "start", "", "http://localhost:3000"],
      "dependsOn": ["stack: up"],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Bora: dev",
      "detail": "Sobe a stack Docker (api 8000 + queue + web 3000) e abre o navegador em localhost:3000",
      "dependsOn": ["abrir navegador"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "stack: parar",
      "detail": "Para api, queue e web (a infra MySQL/Redis continua no ar)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "queue: reiniciar",
      "detail": "Obrigatorio depois de renomear classe ou mexer em service provider (E-018)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "restart", "queue"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "api: migrar banco",
      "detail": "Roda as migrations no MySQL da stack infra (exige infra-mysql no ar)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "api", "php", "artisan", "migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "api: testes",
      "detail": "php artisan test no container (usa o banco bora_test)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "api", "php", "artisan", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "web: build",
      "detail": "Build de producao do front, no host — usar para checar se o TypeScript passa",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    }
  ]
}
