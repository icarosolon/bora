APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Bora / spec 001 (contas e autenticacao) ---------------------------------

# Origens autorizadas no CORS, separadas por virgula. Vale como allowed_origins
# explicito (config/cors.php). NUNCA usar "*": a area logada e autenticada por
# token Bearer e origem declarada e o minimo do Principio V.
FRONTEND_URLS=http://localhost:3000

# Google OAuth (RN-PLAT-002). Criar em console.cloud.google.com > Google Auth
# Platform > Clientes > Aplicativo da Web.
# ATENCAO: o redirect aponta para o web/ (porta 3000), NAO para a API — o Google
# devolve o code a uma pagina do Next, que o repassa por POST. E o que mantem o
# token fora da URL. O mesmo valor precisa estar registrado no console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/entrar/google/retorno

# E-mail transacional (decisao D8). Em dev o MAIL_MAILER fica em "log" e os
# e-mails saem em storage/logs/laravel.log; em producao, resend.
RESEND_API_KEY=

# Parametros do dominio (config/bora.php). Todos tem default no config; declarar
# aqui so para sobrescrever.
# BORA_SENHA_MINIMA=8
# BORA_SESSAO_VALIDADE_DIAS=30
# BORA_TENTATIVAS_POR_MINUTO=5
# BORA_TOKEN_VERIFICACAO_MIN=10080
# BORA_TOKEN_REDEFINICAO_MIN=60
# BORA_TOKEN_UNIAO_MIN=60
# BORA_UNIAO_VALIDADE_MIN=15
